{
  "name": "pi-code-graph",
  "version": "0.16.0",
  "description": "Code Graph RAG extension for pi-coding-agent - query codebase knowledge graphs for intelligent code understanding",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "eval:ax-cypher:legacy": "tsx evals/ax-cypher/run-baseline.ts",
    "eval:ax-cypher:rg": "tsx evals/ax-cypher/run-rg.ts",
    "eval:ax-cypher": "tsx evals/ax-cypher/run-ax.ts",
    "clean": "rm -rf node_modules"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/code-graph-rag"
    ]
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "code-graph-rag",
    "rag",
    "knowledge-graph",
    "codebase",
    "memgraph"
  ],
  "author": "picassio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/picassio/pi-code-graph"
  },
  "homepage": "https://github.com/picassio/pi-code-graph#readme",
  "bugs": {
    "url": "https://github.com/picassio/pi-code-graph/issues"
  },
  "files": [
    "src/",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ax-llm/ax": "^21.0.12",
    "@iarna/toml": "^2.2.5",
    "@vscode/tree-sitter-wasm": "^0.3.0",
    "@zvec/zvec": "^0.2.3",
    "neo4j-driver": "^6.0.1",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4.22.3",
    "typebox": "^1.1.38",
    "typescript": "^5.4.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
